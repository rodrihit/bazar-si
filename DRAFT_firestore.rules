rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitives
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // 4. Entity Validations
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100
        && data.price is number && data.price >= 0
        && data.stock is int && data.stock >= 0
        && data.category is string
        && (!('discountPrice' in data) || (data.discountPrice is number && data.discountPrice >= 0))
        && data.images is list && data.images.size() <= 10;
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0
        && data.customerEmail is string && data.customerEmail.size() > 0
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.total is number && data.total >= 0
        && data.status in ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled']
        && (data.customerEmail == request.auth.token.email || isAdmin());
    }

    // 5. Collection Matches
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn() && isValidOrder(incoming()) && isValidId(orderId) 
        && incoming().createdAt == request.time;
      allow read: if isSignedIn() && (resource.data.customerEmail == request.auth.token.email || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerEmail == request.auth.token.email || isAdmin());
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().content.size() < 500 && isValidId(testimonialId);
      allow delete, update: if isAdmin();
    }

    match /settings/{config} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
